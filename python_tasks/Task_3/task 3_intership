   "source": [
    "nums = [2, 7, 11, 15]\n",
    "target = 9\n",
    "\n",
    "seen = []\n",
    "pair = []\n",
    "\n",
    "# Scan the second element from left to right; choose the earliest\n",
    "# earlier element that completes the target.\n",
    "for num in nums:\n",
    "    for earlier in seen:\n",
    "        if earlier + num == target:\n",
    "            pair = [earlier, num]\n",
    "            break\n",
    "    if pair:\n",
    "        break\n",
    "    seen.append(num)\n",
    "\n",
    "print(pair)"
